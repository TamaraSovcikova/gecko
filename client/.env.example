# client/.env.example
# Copy to client/.env and fill in. Never commit client/.env (gitignored).
# Note: VITE_* values end up in the production bundle and are public-by-design.

# Backend base URL used by the frontend
VITE_API_URL=http://localhost:3001

# Firebase client config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional flags
# VITE_DISABLE_FORECAST=true
