# Root .env.example
# The root package only runs orchestration scripts (concurrently, seed, verify).
# Real config lives in server/.env and client/.env.
#
# The seed script reads MONGODB_URI; set it here OR in server/.env (the seed
# command runs from server/ via the workspace script).

# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# Optional seed overrides (see README "Seed data")
# SEED_USER_ID=seed-user-001
# SEED_USER_EMAIL=seed@example.com
# SEED_USER_NAME=Seed User
# SEED_MONTH=4
# SEED_YEAR=2026
# SEED_BADGE_RESET_TOKEN=
