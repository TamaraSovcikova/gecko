# server/.env.example
# Copy to server/.env and fill in. Never commit server/.env (gitignored).

# Core
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=

# Firebase Admin SDK (service account). Single-line key; literal \n -> newlines at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI assistant (Groq)
GROQ_API_KEY=

# Salary lookups (Adzuna)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Receipt scanning (OCR.space)
OCR_SPACE_API_KEY=

# Quizzes (QuizAPI.io). Optional; falls back to built-in quizzes if unset.
QUIZ_API_KEY=

# Newsletter email (nodemailer / SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset.
NEWSLETTER_FROM_EMAIL=
# Used to build unsubscribe links inside newsletter emails.
API_URL=http://localhost:3001

# Newsletter scheduler
NEWSLETTER_SCHEDULER_ENABLED=true
NEWSLETTER_CRON=0 9 1 * *
NEWSLETTER_TIMEZONE=Europe/London
